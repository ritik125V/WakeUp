PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Paste your MongoDB Atlas or local URI here)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wakeup
MONGO_URI=mongodb://localhost:27017/wakeup

# Redis Connection URL (using local Redis-Stack port)
REDIS_URL=redis://localhost:6379

# Supabase Credentials & Direct Postgres Database URL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Nodemailer / Email Report Notification Service (Google App Password)
# To use Google App Passwords:
# 1. Enable 2-Step Verification in Google Account -> Security.
# 2. Search "App passwords" -> Create an app password for "WakeUp Automation".
# 3. Paste the 16-character password below into SMTP_PASS (with or without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="WakeUp Automation" <no-reply@wakeup.io>

